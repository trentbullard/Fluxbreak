[gd_resource type="Resource" script_class="LogisticsDef" format=3]

[ext_resource type="Script" path="res://content/defs/logistics_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = "blacklist"
display_name = "Blacklist"
description = "+1 blacklist per run. Exclude an upgrade family, including every tier, from all stations for that run. Already purchased upgrades stay active. Uses refill each new run."
max_tiers = 1
base_cost = 150
cost_multiplier = 1.0
