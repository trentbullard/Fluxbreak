script = ExtResource("1_def")
boss_description = "The Witness relocates before marking a crossing lane and a current-position rupture. Its directional tether briefly slows movement; leave the marked corridor, gain distance, or destroy the source to break free. Below 55% combined hull and shields the cadence quickens. Change heading or climb away from committed warnings."
