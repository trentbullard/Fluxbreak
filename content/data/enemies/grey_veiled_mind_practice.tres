script = ExtResource("1_def")
boss_description = "The Veiled Mind predicts your course with locked forecasts. Below 70% combined hull and shields it pairs current-position and forecast ruptures; below 35% it adds crossing lanes to three-part collapses. Relocations and tether attempts set up fresh, fully warned attacks. Change heading and use the visible escape lanes; committed warnings never chase you."
