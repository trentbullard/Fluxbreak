[resource]
script = ExtResource("1")
stage_id = &"grey_observatory"
display_name = "Silent Observatory"
description = "Five lessons introduce the complete Grey fleet, followed by The Witness or The Veiled Mind. Leave each locked volume and use recovery and tether immunity windows."
combat_hint = "Five waves, then a Grey boss. Harbingers warn twice; leave each rupture sphere.\nBlue shifts are harmless. Break a tether by moving away or destroying its source, then use the immunity window to reposition."
completion_flow = 3
boss_wave_index = 6
boss_faction = ExtResource("4")
boss_pool = Array[ExtResource("2")]([ExtResource("5"), ExtResource("11")])
wave_timeout_override_sec = 22.0
downtime_override_sec = 5.0
ordered_wave_cards = true
authored_enemy_budgets = PackedInt32Array(4, 8, 12, 16, 22)
authored_tier_caps = PackedInt32Array(1, 2, 3, 4, 5)
pressure_reinforcements_enabled = false
wave_cards = Array[ExtResource("3")]([ExtResource("6"), ExtResource("7"), ExtResource("8"), ExtResource("9"), ExtResource("10")])
ambient_light_color = Color(0.12, 0.15, 0.24, 1)
ambient_light_energy = 4.6
star_light_color = Color(0.75, 0.8, 1.0, 1)
volumetric_fog_density = 0.003
