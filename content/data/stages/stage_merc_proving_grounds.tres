[resource]
script = ExtResource("1")
stage_id = &"merc_proving_grounds"
display_name = "Merc Proving Grounds"
description = "Five lessons introduce the complete Merc fleet, followed by Contract Enforcer or Vanguard Flagship. Leave amber warnings before they resolve and use capital-ship recovery windows."
combat_hint = "Five waves, then a Merc boss. Leave amber warnings before FIRE.\nApproach shield Frigates. Cruisers recover after broadsides; destroy Carriers to stop new launches, then clear their surviving escorts."
completion_flow = 3
boss_wave_index = 6
boss_faction = ExtResource("4")
boss_pool = Array[ExtResource("2")]([ExtResource("5"), ExtResource("11")])
wave_timeout_override_sec = 22.0
downtime_override_sec = 5.0
ordered_wave_cards = true
authored_enemy_budgets = PackedInt32Array(3, 7, 10, 16, 22)
authored_tier_caps = PackedInt32Array(1, 2, 3, 4, 5)
pressure_reinforcements_enabled = false
wave_cards = Array[ExtResource("3")]([ExtResource("6"), ExtResource("7"), ExtResource("8"), ExtResource("9"), ExtResource("10")])
ambient_light_color = Color(0.24, 0.2, 0.14, 1)
ambient_light_energy = 5.5
star_light_color = Color(1, 0.87, 0.7, 1)
volumetric_fog_density = 0.005
